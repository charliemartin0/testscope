{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/charliemartin0/testscope/schema.json",
  "title": "testscope configuration",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "relPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|^[A-Za-z]:|(^|[\\\\/])\\.\\.([\\\\/]|$))"
      }
    },
    "envName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "policy": {
      "enum": ["smoke", "all", "manifest", "fail"]
    },
    "globs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "root": {
      "$ref": "#/$defs/relPath",
      "default": ".",
      "description": "Directory containing the tests, relative to the config file."
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "playwright",
          "default": "playwright"
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projectsEnv": {
          "$ref": "#/$defs/envName",
          "description": "Env var that receives the comma-separated groups of the selected specs."
        },
        "smokeGrep": {
          "type": "string",
          "description": "Grep applied to smoke-only runs, e.g. @smoke."
        },
        "outputDir": {
          "$ref": "#/$defs/relPath"
        },
        "onlyChanged": {
          "type": "boolean",
          "default": true,
          "description": "Ask the runner which specs depend on changed files (Playwright --only-changed)."
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/relPath",
          "default": "testscope.manifest.json"
        },
        "specs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["**/*.spec.{ts,tsx,js,mjs}"],
          "description": "Globs (relative to root) of spec files."
        },
        "routePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["\\.goto\\(\\s*['\"`]([^'\"`$]+)"],
          "description": "Regexes; capture group 1 is a route the spec visits."
        },
        "titlePattern": {
          "type": "string",
          "default": "describe(?:\\.\\w+)*\\(\\s*['\"`]([^'\"`]+)",
          "description": "Regex; capture group 1 is the spec title."
        },
        "smokeTag": {
          "type": "string",
          "default": "@smoke"
        },
        "groupPattern": {
          "type": "string",
          "description": "Regex on the spec path; capture group 1 becomes the group."
        },
        "sourceRules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["match", "sources"],
            "properties": {
              "match": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "Derive source globs from spec paths; $1.. are capture groups of match."
        }
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "canary": {
          "type": "string",
          "description": "Spec that always runs (smoke-only unless directly affected)."
        }
      }
    },
    "shared": {
      "$ref": "#/$defs/globs",
      "description": "Changes here invalidate every spec (lockfiles, runner config, fixtures, .env*, OpenAPI)."
    },
    "ignore": {
      "$ref": "#/$defs/globs"
    },
    "extraDiffRoots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relPath"
      },
      "description": "Repository-relative directories outside root (e.g. a backend) whose changes are considered."
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["none", "http", "command"],
          "default": "none"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "apiKeyEnv": {
          "$ref": "#/$defs/envName",
          "description": "NAME of the env var holding the key. Never the key itself."
        },
        "model": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.25
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 15000
        },
        "cache": {
          "type": ["boolean", "string"],
          "default": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "http"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["url"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "command"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["command"]
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onJudgeError": {
          "$ref": "#/$defs/policy",
          "default": "smoke"
        },
        "onAllSelected": {
          "$ref": "#/$defs/policy",
          "default": "all"
        },
        "onUnmapped": {
          "$ref": "#/$defs/policy",
          "default": "smoke"
        },
        "maxSpecs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "workers": {
      "type": "integer",
      "minimum": 1,
      "default": 2
    }
  }
}
