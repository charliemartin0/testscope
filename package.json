{
  "name": "testscope",
  "version": "1.0.0",
  "description": "Jev-based affected-test selection GitHub Action with playwright, vitest and dotnet adapters",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "testscope": "dist/cli/index.js"
  },
  "scripts": {
    "build": "ncc build src/main.ts -o dist/action --license licenses.txt && ncc build src/bin.ts -o dist/cli",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixture": "bash scripts/make-fixture.sh"
  },
  "dependencies": {
    "@actions/artifact": "^2.3.2",
    "@actions/cache": "^4.1.0",
    "@actions/core": "^1.11.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vercel/ncc": "^0.45.0",
    "vitest": "^5.0.5"
  }
}
